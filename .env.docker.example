# Minimal Docker Compose env for supply-chain-knowledge-hub (public fork)
# Usage: cp .env.docker.example .env && docker compose up -d
#
# Stack: frontend (nginx) + app (Go) + docreader + postgres (ParadeDB/pgvector) + redis
# Vector store: RETRIEVE_DRIVER=postgres (no extra qdrant/milvus profile required)

GIN_MODE=release
LOG_LEVEL=info

# --- Database (compose service: postgres) ---
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=WeKnora

# --- Vector + storage ---
RETRIEVE_DRIVER=postgres
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
STREAM_MANAGER_TYPE=redis

# --- Redis (compose service: redis) ---
REDIS_PASSWORD=redis123!@#
REDIS_DB=0
REDIS_PREFIX=stream:

# --- Security (change before any public deployment) ---
TENANT_AES_KEY=weknorarag-api-key-secret-secret
SYSTEM_AES_KEY=weknora-system-aes-key-32bytes!!
JWT_SECRET=weknora-jwt-secret

# --- App / UI ports (host) ---
FRONTEND_PORT=80
APP_PORT=8080
APP_HOST=app
APP_SCHEME=http

# --- Docreader ---
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

# --- Optional LLM (Ollama on host) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Feature flags ---
DISABLE_REGISTRATION=false
ENABLE_GRAPH_RAG=false
NEO4J_ENABLE=false
WEKNORA_SANDBOX_MODE=docker
AUTO_RECOVER_DIRTY=true
WEKNORA_LANGUAGE=en-US

# --- Langfuse: leave unset for default stack (do not copy pk-lf-xxx placeholders) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
